SENDGRID_API_KEY=your_sendgrid_api_key
ALERT_EMAIL_FROM=your_verified_sender@example.com
ALERT_EMAIL_TO=carsonblack2@gmail.com
FLASK_SECRET_KEY=any_random_string_of_characters

# Only needed when deployed (e.g. on Render) with a Postgres database
# attached. Leave unset locally - the app falls back to the local SQLite
# file automatically when this isn't present.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Cloudflare Turnstile (bot check on login/signup). For local development,
# use Cloudflare's official dummy test keys (always pass, work on
# localhost) - real keys should only be set on the live deployment.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
